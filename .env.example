# Copy to .env and fill in. .env is gitignored; never commit real values.

# users-service database. Pick one:
# - Neon (shared dev database): copy the *direct* connection string from the Neon dashboard
USERS_DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxxx.eu-west-2.aws.neon.tech/users_db?sslmode=verify-full"
# - Local Postgres in Docker (docker compose -f infra/docker-compose.yml up -d)
# USERS_DATABASE_URL="postgresql://plim:plim_dev_password@localhost:5432/users_db?schema=public"
# After switching, create the tables with: npm run db:users:deploy

# catalog-service database (its own database: one per service). Same two options:
CATALOG_DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxxx.eu-west-2.aws.neon.tech/catalog_db?sslmode=verify-full"
# CATALOG_DATABASE_URL="postgresql://plim:plim_dev_password@localhost:5432/catalog_db?schema=public"
# Create the tables with: npm run db:catalog:deploy

# booking-service database. Same two options:
BOOKINGS_DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxxx.eu-west-2.aws.neon.tech/bookings_db?sslmode=verify-full"
# BOOKINGS_DATABASE_URL="postgresql://plim:plim_dev_password@localhost:5432/bookings_db?schema=public"
# Create the tables with: npm run db:bookings:deploy

AUTH0_ISSUER_URL="https://dev-4dou7t53642iyecw.eu.auth0.com/"
AUTH0_AUDIENCE="https://api.plim.app"

GATEWAY_PORT=3000
USERS_SERVICE_PORT=3001
# where the gateway reaches users-service
USERS_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_PORT=3002
CATALOG_SERVICE_URL="http://localhost:3002"
BOOKING_SERVICE_PORT=3003
BOOKING_SERVICE_URL="http://localhost:3003"
ADMIN_SERVICE_PORT=3004
ADMIN_SERVICE_URL="http://localhost:3004"
# Set this to your admin-service database connection string.
# ADMIN_DATABASE_URL="postgresql://<user>:<password>@localhost:5432/admin_db?schema=public"

# shared secret the gateway sends to internal services (X-Internal-Token).
# Any long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SERVICE_TOKEN="<long random value>"

# Private file storage for professionals' documents. Pick one:
# - AWS S3: create a private bucket (Block all public access ON) and an IAM user whose policy allows
#   s3:PutObject, s3:GetObject, s3:DeleteObject on arn:aws:s3:::<bucket>/* . No endpoint needed.
STORAGE_REGION="eu-south-2"
STORAGE_ACCESS_KEY_ID="<IAM access key id>"
STORAGE_SECRET_ACCESS_KEY="<IAM secret access key>"
STORAGE_BUCKET="<bucket name>"
# - Local S3-compatible container (docker compose -f infra/docker-compose.yml up -d):
# STORAGE_ENDPOINT="http://localhost:7070"
# STORAGE_REGION="us-east-1"
# STORAGE_ACCESS_KEY_ID="plim"
# STORAGE_SECRET_ACCESS_KEY="plim_dev_password"
# STORAGE_BUCKET="plim-documents"

# Finding a professional for a booking (booking-service)
# The offer deadline, how many professionals are asked, and the hours before a finished job is
# confirmed automatically are admin settings (admin-service). Set these only to override them locally:
# OFFER_TIMEOUT_MINUTES=15
# MAX_OFFERS=5
# RELEASE_AFTER_HOURS=48
OFFER_SWEEP_MS=30000       # how often expired offers are checked
# PAYMENTS_REQUIRED=true   # once payments exist: a booking waits for payment before professionals are asked
# Stripe sandbox (12c)
# PAYMENTS_SERVICE_PORT=3005
# PAYMENTS_SERVICE_URL=http://localhost:3005
# PAYMENTS_RETURN_URL=http://localhost:8081/bookings
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_... # optional sandbox configuration
# PAYMENTS_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/payments_db
# CONNECT_RETURN_URL=http://localhost:8081/bookings

# Kafka (comma-separated if there are several brokers)
KAFKA_BROKERS="localhost:9092"
# how often services retry outbox events that couldn't be sent (ms)
OUTBOX_POLL_MS=30000

# web origins allowed to call the gateway (comma-separated)
CORS_ORIGINS="http://localhost:8081"
