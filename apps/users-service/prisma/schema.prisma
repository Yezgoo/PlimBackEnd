generator client {
  provider = "prisma-client"                 // Prisma 7's ESM-first generator
  output   = "../src/generated/prisma"       // generated code goes inside the service
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  auth0Id   String   @unique @map("auth0_id")   // links this user to their Auth0 login
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}