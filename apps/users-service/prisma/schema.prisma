generator client {
  provider = "prisma-client"                 // Prisma 7's ESM-first generator
  output   = "../src/generated/prisma"       // generated code goes inside the service
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  auth0Id   String   @unique @map("auth0_id")   // links this user to their Auth0 login
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  professional Professional?

  @@map("users")
}

enum ProfessionalStatus {
  applied    // sent the application, waiting for an admin
  approved   // can receive jobs
  rejected
  suspended
}

// A user who also works on the platform. One person, one login: customers and pros are both users.
model Professional {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  businessName        String?            @map("business_name")
  nif                 String             @unique                      // Portuguese tax number, 9 digits
  activityRegistered  Boolean            @map("activity_registered")  // "atividade aberta" at the tax office
  insurancePolicy     String?            @map("insurance_policy")     // civil liability insurance
  insuranceValidUntil DateTime?          @map("insurance_valid_until") @db.Date
  bio                 String?
  status              ProfessionalStatus @default(applied)
  verifiedAt          DateTime?          @map("verified_at")          // set on approval: the "Verificado" badge
  rejectionReason     String?            @map("rejection_reason")     // shown to the applicant
  reviewedBy          String?            @map("reviewed_by")          // the admin's Auth0 id
  reviewedAt          DateTime?          @map("reviewed_at")
  ratingAvg           Decimal?           @map("rating_avg") @db.Decimal(3, 2) // kept up to date from reviews
  ratingCount         Int                @default(0) @map("rating_count")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ProDocument[]
  areas     ProArea[]
  services  ProService[]
  slots     AvailabilitySlot[]
  timeOff   TimeOff[]

  @@map("professionals")
}

enum ProDocumentType {
  id_card
  activity_proof        // proof of an open activity at the tax office
  liability_insurance
  certificate           // professional qualification
}

enum ProDocumentStatus {
  uploading  // an upload link was issued, the file hasn't been confirmed yet
  pending    // uploaded, waiting for an admin
  accepted
  rejected
}

// A file a professional sends to be verified. The file itself lives in private storage (S3);
// this row only keeps where it is and what an admin decided.
model ProDocument {
  id              String            @id @default(uuid()) @db.Uuid
  professionalId  String            @map("professional_id") @db.Uuid
  type            ProDocumentType
  fileKey         String            @unique @map("file_key")   // path inside the bucket, never a public URL
  fileName        String?           @map("file_name")          // the name on the person's phone, for display only
  contentType     String            @map("content_type")
  sizeBytes       Int               @map("size_bytes")
  status          ProDocumentStatus @default(uploading)
  rejectionReason String?           @map("rejection_reason")
  reviewedBy      String?           @map("reviewed_by")          // the admin's Auth0 id (admins need no Plim profile)
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("pro_documents")
}

// --- Where, what and when a professional works. Together these answer "who can take this job?" ---

// A municipality the professional accepts jobs in. The code is the INE code from catalog-service ("0603" = Coimbra).
model ProArea {
  professionalId   String @map("professional_id") @db.Uuid
  municipalityCode String @map("municipality_code")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([professionalId, municipalityCode])
  @@index([municipalityCode])
  @@map("pro_areas")
}

// A catalog service the professional does. The id belongs to catalog-service (no foreign key across databases).
model ProService {
  professionalId String @map("professional_id") @db.Uuid
  serviceTypeId  String @map("service_type_id") @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("pro_services")
}

// One block of the weekly timetable, e.g. Monday 09:00 to 13:00. Times are Lisbon local time.
model AvailabilitySlot {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  weekday        Int                              // 1 = Monday ... 7 = Sunday (ISO)
  startMinute    Int    @map("start_minute")      // minutes after midnight: 540 = 09:00
  endMinute      Int    @map("end_minute")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("availability_slots")
}

// A period the professional is not available (holidays, illness), whatever the timetable says
model TimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, endsAt])
  @@map("time_off")
}

// Transactional outbox: an event is saved in the same transaction as the change it describes,
// and OutboxRelay sends it to Kafka afterwards. If Kafka is down, the event waits here instead of being lost.
model OutboxEvent {
  id          String    @id @db.Uuid                    // = the event's eventId
  topic       String
  key         String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")             // null = still to be sent

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

