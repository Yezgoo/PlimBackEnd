generator client {
  provider = "prisma-client"                 // Prisma 7's ESM-first generator
  output   = "../src/generated/prisma"       // generated code goes inside the service
}

datasource db {
  provider = "postgresql"
}

// The life of a booking, in order. Each step is reached in a later roadmap step.
enum BookingStatus {
  pending_payment  // created, waiting for the customer's payment
  finding_pro      // paid; being offered to professionals, one at a time
  accepted         // a professional took it
  en_route
  in_progress
  done             // the professional says the work is finished
  confirmed        // the customer confirmed (or 48 h passed): the professional gets paid
  cancelled
  disputed
}

// One job a customer booked. Everything agreed at checkout is COPIED here (service name, price,
// address), so later changes to the catalog or to the customer's profile never change a booking.
model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid       // users-service user id
  professionalId   String?       @map("professional_id") @db.Uuid   // set when a professional accepts
  serviceTypeId    String        @map("service_type_id") @db.Uuid   // catalog-service id
  serviceSlug      String        @map("service_slug")
  serviceName      String        @map("service_name")               // copy
  durationMinutes  Int           @map("duration_minutes")           // copy
  address          Json                                              // copy: { street, details, postalCode, city }
  municipalityCode String        @map("municipality_code")
  scheduledStart   DateTime      @map("scheduled_start")
  scheduledEnd     DateTime      @map("scheduled_end")              // start + duration
  priceCents       Int           @map("price_cents")                // copy, VAT included
  serviceFeeCents  Int           @default(0) @map("service_fee_cents")
  totalCents       Int           @map("total_cents")
  discountCents    Int           @default(0) @map("discount_cents")
  couponCode       String?       @map("coupon_code")
  commissionBps    Int?          @map("commission_bps")
  commissionCents  Int?          @map("commission_cents")
  proPayoutCents   Int?          @map("pro_payout_cents")
  vatRate          Decimal       @map("vat_rate") @db.Decimal(4, 2) // copy
  currency         String        @default("EUR")
  notes            String?                                           // from the customer to the professional
  status           BookingStatus @default(pending_payment)
  // The cancellation terms agreed when booking (copies: later policy changes never touch this booking)
  freeCancelUntil     DateTime? @map("free_cancel_until")        // the customer may cancel for free until then
  lateCancelFeeCents  Int?      @map("late_cancel_fee_cents")    // what a later cancellation costs
  // What happened, if it was cancelled
  cancelReason     String?       @map("cancel_reason")   // no_pro_found, customer, no_show
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationFeeCents Int?     @map("cancellation_fee_cents")  // charged to the customer (0 when free)
  refundCents         Int?      @map("refund_cents")            // total minus the fee: what goes back to the customer
  doneAt           DateTime?     @map("done_at")                    // the professional marked the work finished
  releaseAt        DateTime?     @map("release_at")                 // when it is confirmed automatically if the customer says nothing
  confirmedAt      DateTime?     @map("confirmed_at")               // confirmed by the customer, or automatically at releaseAt
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  events BookingEvent[]
  payment BookingReceipt?
  invoice BookingInvoice?
  emails BookingEmail[]
  pushEvents ProcessedPushEvent[]
  offers BookingOffer[]
  dispute BookingDispute?

  @@index([customerId, scheduledStart])
  @@index([professionalId, scheduledStart])
  @@index([status])
  @@index([status, releaseAt])
  @@map("bookings")
}

model BookingInvoice {
  bookingId String @id @map("booking_id") @db.Uuid
  billingName String @map("billing_name")
  nif String?
  issuedAt DateTime? @map("issued_at")
  reference String?
  issuedBy String? @map("issued_by")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_invoices")
}

enum DisputeResolution {
  refund
  pay_professional
}

model BookingDispute {
  bookingId  String             @id @map("booking_id") @db.Uuid
  evidence   String
  openedAt   DateTime           @default(now()) @map("opened_at")
  resolution DisputeResolution?
  resolvedAt DateTime?          @map("resolved_at")
  resolvedBy String?            @map("resolved_by")
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([resolution, openedAt])
  @@map("booking_disputes")
}

model PushDevice {
  token String @id
  userId String @map("user_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  events ProcessedPushEvent[]

  @@index([userId], map: "push_devices_user")
  @@index([professionalId], map: "push_devices_professional")
  @@map("push_devices")
}

model ProcessedPushEvent {
  id BigInt @id @default(autoincrement())
  bookingId String @map("booking_id") @db.Uuid
  token String
  userId String @map("user_id") @db.Uuid
  kind String
  eventKey String @map("event_key")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  device PushDevice @relation(fields: [token], references: [token], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventKey, token])
  @@map("processed_push_events")
}

model BookingEmail {
  bookingId String @map("booking_id") @db.Uuid
  kind String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz(6)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  envelope Json?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([bookingId, kind])
  @@map("booking_emails")
}

model Coupon {
  code String @id
  fixedCents Int? @map("fixed_cents")
  percent Int?
  active Boolean @default(true)

  @@map("coupons")
}

model BookingReceipt {
  bookingId String @id @map("booking_id") @db.Uuid
  intentId String @unique @map("intent_id")
  eventId String @unique @map("event_id")
  amountCents Int @map("amount_cents")
  receivedAt DateTime @default(now()) @map("received_at")
  settledAt DateTime? @map("settled_at")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_receipts")
}

enum OfferStatus {
  pending   // waiting for the professional's answer
  accepted
  declined
  expired   // no answer before the deadline
}

// "Do you want this job?" A booking is offered to one professional at a time;
// a decline or a missed deadline creates the next offer, for the next professional.
model BookingOffer {
  id             String      @id @default(uuid()) @db.Uuid
  bookingId      String      @map("booking_id") @db.Uuid
  professionalId String      @map("professional_id") @db.Uuid   // users-service professional id
  position       Int                                              // 1 = first professional asked, 2 = second ...
  status         OfferStatus @default(pending)
  offeredAt      DateTime    @default(now()) @map("offered_at")
  expiresAt      DateTime    @map("expires_at")
  respondedAt    DateTime?   @map("responded_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, professionalId])   // a professional is asked at most once per booking
  @@index([professionalId, status])
  @@index([status, expiresAt])
  @@map("booking_offers")
}

// One row per status change: the full history, for support and disputes
model BookingEvent {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")   // null for the first row (creation)
  toStatus   BookingStatus  @map("to_status")
  changedBy  String?        @map("changed_by")    // user id, or null when the system did it
  at         DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
  @@map("booking_events")
}
